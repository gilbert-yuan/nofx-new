PORT=3100
NOFX_MONTHLY_ML_PORT=18084
DATA_DIR=./data
CORS_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nofx_lite
PGSSL=false
# PostgreSQL connection pool. Max must be >= 4 for nested trading lock transactions.
NOFX_DB_POOL_MAX_CONNECTIONS=12
NOFX_DB_POOL_MIN_CONNECTIONS=2
NOFX_DB_POOL_ACQUIRE_TIMEOUT_MS=10000
# 0 disables idle/lifetime retirement. Values below are milliseconds.
NOFX_DB_POOL_IDLE_TIMEOUT_MS=600000
NOFX_DB_POOL_MAX_LIFETIME_MS=1800000
NOFX_DB_POOL_TEST_BEFORE_ACQUIRE=true
# Bound SQL lock waits without replaying writes.
NOFX_DB_LOCK_TIMEOUT_MS=10000
# Local / multi-timeframe / enhanced / super rule engines allow both directions.
NOFX_LONG_ONLY=false
# OKX proxy override: unset uses HTTPS_PROXY / HTTP_PROXY, then localhost:7890.
# Set an empty value to explicitly use a direct connection (if reachable).
# OKX_PROXY_URL=http://127.0.0.1:7890
