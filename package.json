{
  "name": "nofx-new",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bash start.sh",
    "stop": "bash start.sh stop",
    "status": "bash start.sh status",
    "logs": "bash start.sh logs",
    "build": "vite build",
    "build:server": "cargo build --release --locked --bin nofx-server",
    "dev": "cargo run --locked --bin nofx-server",
    "dev:web": "vite --host 127.0.0.1",
    "preview": "vite preview",
    "test": "cargo test --locked --all-targets",
    "check": "cargo check --locked --all-targets",
    "fmt": "cargo fmt --all -- --check",
    "clippy": "cargo clippy --locked --all-targets -- -D warnings"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "pinia": "^2.3.1",
    "vite": "^6.3.5",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "pm2": "^7.0.3"
  }
}
