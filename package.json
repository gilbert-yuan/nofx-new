{
  "name": "nofx-new",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate:simulated-account": "node scripts/migrate-simulated-account.js",
    "test": "node --test tests/*.test.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "nodemon --ignore data server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "pm2:start": "set \"PM2_HOME=%CD%\\.pm2\" && pm2 start ecosystem.config.cjs",
    "pm2:restart": "set \"PM2_HOME=%CD%\\.pm2\" && pm2 startOrRestart ecosystem.config.cjs --update-env",
    "pm2:stop": "set \"PM2_HOME=%CD%\\.pm2\" && pm2 stop nofx-api nofx-web",
    "pm2:delete": "set \"PM2_HOME=%CD%\\.pm2\" && pm2 delete nofx-api nofx-web",
    "pm2:status": "set \"PM2_HOME=%CD%\\.pm2\" && pm2 status",
    "pm2:logs": "set \"PM2_HOME=%CD%\\.pm2\" && pm2 logs",
    "check": "node --check server/index.js && node --check server/ai.js && node --check server/binanceClient.js && node --check server/binanceMarket.js && node --check server/binancePositionMonitor.js && node --check server/researchRoutes.js && node --check server/research.js && node --check server/store.js && node --check server/marketDb.js && node --check server/klineSync.js"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "nodemon": "^3.1.10",
    "pg": "^8.16.3",
    "undici": "^7.29.0",
    "vite": "^6.3.5",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "pm2": "^7.0.3"
  }
}
