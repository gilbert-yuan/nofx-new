//@version=6
// ============================================================================
// 妖币埋伏 v1 (yao-coin-ambush-v1) — TradingView Pine Script 移植
// 源码: rust/src/strategies/yao.rs  (engine: yao-ambush)
//
// 思路: 不追已起飞的妖币，而是在 24h 涨跌/振幅达到目标阈值(默认±50%)之前，
//       用 1m 短线动量 + 量能放大 + 波动放大 + 同向K线占比 + 突破位置 打分预测方向，
//       通过一串研究闸门后，在回踩/反弹参考位挂限价单埋伏，止损/分档止盈按 ATR 给出。
//
// 用法: 挂在 1m 图表上（与线上 planInterval=1m 一致），15m 数据由 request.security 获取。
//
// 与 Rust 源码的已知差异（移植说明）:
//  1. TV 没有 quoteVolume，量能比用 volume 近似。
//  2. 24h 快照与源码一致地用「96 根已收盘 15m 滚动窗口」构造；实时盘中最后一根
//     15m 未收盘时会与线上 ticker 有微小差异。
//  3. 15m ATR 源码用 true range 简单均值，这里用 ta.atr (RMA)，趋势确认间距略有出入。
//  4. 动态币种画像 (profile: 市值/流通率/成交额/排名) 依赖外部市场元数据，TV 内不可得，
//     未移植 —— 请自行维护 watchlist。
//  5. 出场按 yao_exit 简化实现: TP1/TP2 各平 40% 限价，剩余挂 TP3 限价 + 阶梯移动止损
//     (atR 0/1/2 → trailR 0.7/0.5/0.4, lockR 0/0.3/0.8)，超时强平。
//  6. calibrate(raw, true) 的目标命中校准仅用于展示，不参与交易闸门（与源码 analyze 相同）。
// ============================================================================

strategy("妖币埋伏 v1 · Yao Coin Ambush", shorttitle = "YAO-Ambush", overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     commission_type = strategy.commission.percent, commission_value = 0.06,
     calc_on_every_tick = false, process_orders_on_close = true,
     max_bars_back = 500)

// ─────────────────────────────── 输入（默认值 = registry.json） ───────────────────────────────
// 阈值与闸门
targetAmplitudePct = input.float(50,   "目标振幅阈值 %（达到即不追入）", group = "闸门")
minProbabilityPct  = input.float(50,   "校准方向概率门槛 %",              group = "闸门")
minRawProbability  = input.float(90,   "原始规则分数门槛",               group = "闸门")
minCurrentAmp      = input.float(12,   "最小观察振幅 %",                 group = "闸门")
maxCurrentAmp      = input.float(48,   "最大观察振幅 %",                 group = "闸门")
minRetDirPct       = input.float(-3,   "方向一致动量下限 %",             group = "闸门")
maxRetDirPct       = input.float(8,    "方向一致动量上限 %（防追高）",    group = "闸门")
minRange6hPct      = input.float(6,    "近6h振幅下限 %",                 group = "闸门")
minDistHigh24hPct  = input.float(5,    "距24h高点最小回落 %",            group = "闸门")
minVolumeRatio     = input.float(1.2,  "量能比下限",                     group = "闸门")
minRangeRatio      = input.float(1.5,  "波动比下限",                     group = "闸门")
minConsistencyPct  = input.float(70,   "同向K线净占比下限 %",            group = "闸门")

// 特征窗口（1m 图表根数）
recentBars   = input.int(12, "动量窗口 recentBars",   minval = 3,  group = "窗口")
baselineBars = input.int(30, "基线窗口 baselineBars", minval = 3,  group = "窗口")
breakoutBars = input.int(40, "突破窗口 breakoutBars", minval = 5,  group = "窗口")
atrBars      = input.int(14, "ATR 周期",              minval = 3,  group = "窗口")
minAuxBars   = input.int(96, "24h快照所需15m根数",    minval = 10, group = "窗口")

// 入场 / 风控
entryPullbackAtr = input.float(1.0,   "回踩/反弹深度 (ATR)",   step = 0.05, group = "风控")
entryBandAtr     = input.float(0.5,   "挂单区间半宽 (ATR)",    step = 0.05, group = "风控")
stopAtrMult      = input.float(0.5,   "初始止损 (ATR)",        step = 0.05, group = "风控")
minStopPct       = input.float(0.008, "最小止损比例",          step = 0.001, group = "风控")
tp1R             = input.float(1.5,   "TP1 (R)",               group = "风控")
tp2R             = input.float(2.5,   "TP2 (R)",               group = "风控")
tp3R             = input.float(3.5,   "TP3 主止盈 (R)",        group = "风控")
minNetRr         = input.float(1.2,   "成本后盈亏比下限",      group = "风控")
maxHoldBars      = input.int(60,      "最长持仓 (1m根数)",     group = "风控")
orderExpiryBars  = input.int(45,      "限价单有效期 (1m根数)", group = "风控")

// 15m 趋势确认
require15mTrend = input.bool(false, "要求15m趋势与方向一致", group = "15m趋势")
trendFast       = input.int(8,      "15m EMA 快线",          group = "15m趋势")
trendSlow       = input.int(21,     "15m EMA 慢线",          group = "15m趋势")
minSepAtr       = input.float(0.3,  "快慢线最小间距 (15m ATR)", group = "15m趋势")

// 方向开关（对应 longOnly / shortOnly：开关为 true 时另一方向被拦截）
longOnly  = input.bool(true,  "longOnly · 只做多",  group = "方向")
shortOnly = input.bool(false, "shortOnly · 只做空", group = "方向")

// 成本参数（netRR 估算用，对应 costs: feeBps=6, slippageBps=5, fundingBpsPer8h=3）
feeBps      = input.float(6, "单边手续费 bps",     group = "成本")
slipBps     = input.float(5, "单边滑点 bps",       group = "成本")
fundingBps  = input.float(3, "资金费率 bps/8h",    group = "成本")

showPlan = input.bool(true, "图上显示计划价位", group = "显示")

// ─────────────────────────────── 工具函数 ───────────────────────────────
clamp1(x)  => math.max(-1.0, math.min(1.0, x))
clamp01(x) => math.max(0.0, math.min(1.0, x))

// yao.rs::calibrate — 分段线性校准表 (target=false 分支)
f_calibrate(float score) =>
    xs = array.from(60., 65., 70., 75., 80., 85., 90., 92., 94., 96., 98., 99.)
    ys = array.from(0.43, 0.71, 0.87, 1.16, 1.48, 1.91, 2.67, 2.67, 2.67, 4.76, 4.76, 6.84)
    float result = array.get(ys, array.size(ys) - 1)
    if score <= array.get(xs, 0)
        result := array.get(ys, 0)
    else
        for i = 1 to array.size(xs) - 1
            if score <= array.get(xs, i)
                x0 = array.get(xs, i - 1)
                x1 = array.get(xs, i)
                y0 = array.get(ys, i - 1)
                y1 = array.get(ys, i)
                result := y0 + (y1 - y0) * (score - x0) / (x1 - x0)
                break
    result

// ─────────────────────────────── 15m 数据：滚动24h快照 + 6h振幅 + 趋势EMA ───────────────────────────────
// 对应 yao.rs::ticker() 与 analyze 里的 range6h / dist_high_24h / trend15
f_snap() =>
    o24 = open[minAuxBars - 1]              // 24h 前 15m 开盘价
    h24 = ta.highest(high, minAuxBars)      // 24h 最高
    l24 = ta.lowest(low, minAuxBars)        // 24h 最低
    h6  = ta.highest(high, 24)              // 近 24 根 15m = 6h 最高
    l6  = ta.lowest(low, 24)                // 6h 最低
    ef  = ta.ema(close, trendFast)
    es  = ta.ema(close, trendSlow)
    at  = ta.atr(14)
    [o24, h24, l24, h6, l6, ef, es, at]

[o24, h24, l24, h6, l6, emaF15, emaS15, atr15] =
     request.security(syminfo.tickerid, "15m", f_snap(), lookahead = barmerge.lookahead_off)

// ─────────────────────────────── 1m 特征（yao.rs::features） ───────────────────────────────
trVal = ta.tr(true)

// 短线动量: rw = 最近 recentBars 根；r[start] = close[recentBars]
recentRet = (close / close[recentBars] - 1) * 100
prevRet   = (close[recentBars] / close[2 * recentBars] - 1) * 100
accel     = recentRet - prevRet

// 量能比: 最近 recentBars 根均量 / 之前 baselineBars 根均量（中间隔 1 根，与源码窗口一致）
volR = math.sum(volume, recentBars) / recentBars
volB = math.sum(volume[recentBars + 1], baselineBars) / baselineBars
vr   = volB > 0 ? volR / volB : na

// 波动比: 最近窗口均TR / 基线窗口均TR
trR = math.sum(trVal, recentBars) / recentBars
trB = math.sum(trVal[recentBars + 1], baselineBars) / baselineBars
rr  = trB > 0 ? trR / trB : na

// 同向K线净占比
upN  = math.sum(close > open ? 1 : 0, recentBars)
dnN  = math.sum(close < open ? 1 : 0, recentBars)
consistency = upN + dnN > 0 ? (upN - dnN) / (upN + dnN) * 100 : 0

// 突破位置: 前 breakoutBars 根（不含当前根）的高低点
hiB     = ta.highest(high[1], breakoutBars)
loB     = ta.lowest(low[1], breakoutBars)
upBreak = hiB > 0 ? (close - hiB) / hiB * 100 : 0
dnBreak = loB > 0 ? (loB - close) / loB * 100 : 0
breakDir = upBreak > 0 ? clamp01(upBreak / 2) : dnBreak > 0 ? -clamp01(dnBreak / 2) : 0

// 1m ATR（源码为最近 atrBars 根 TR 简单均值）
atr1m  = math.sum(trVal, atrBars) / atrBars
atrPct = atr1m / close * 100

// 数据充分性（对应 sufficient/minBars 及窗口需要的历史）
sufficient = not na(recentRet) and not na(prevRet) and not na(vr) and not na(rr) and not na(hiB) and not na(loB)

// ─────────────────────────────── 方向打分与概率（yao.rs::predict） ───────────────────────────────
// 24h 快照口径: 价格用当前 1m close，开/高/低用 15m 滚动窗口（与 ticker() 的 15m-rolling 一致）
chg24     = not na(o24) and o24 > 0 ? (close / o24 - 1) * 100 : na
amplitude = not na(chg24) ? math.max(math.abs(chg24), (h24 - l24) / o24 * 100) : na
range6h   = not na(h6) and close > 0 ? (h6 - l6) / close * 100 : na
distHigh  = not na(h24) and close > 0 ? (h24 / close - 1) * 100 : na

dirScore = clamp1(chg24 / 50) * 25 + clamp1(recentRet / 5) * 25 + clamp1(accel / 5) * 15 +
     clamp1(consistency / 100) * 20 + clamp1(breakDir) * 15

dirRaw = na(chg24) ? 0 :
     math.abs(dirScore) >= 5 ? math.sign(dirScore) :
     chg24 > 0 ? 1 : chg24 < 0 ? -1 :
     recentRet > 0 ? 1 : recentRet < 0 ? -1 : 0

activity = 35 * clamp01((math.abs(chg24) - 5) / 35) +
     25 * clamp01(dirRaw * recentRet / 5) +
     15 * clamp01(dirRaw * accel / 5) +
     15 * clamp01(dirRaw * consistency / 100) +
     10 * clamp01(dirRaw * breakDir) +
     20 * clamp01((vr - 1) / 3) +
     10 * clamp01((rr - 1) / 2)

rawScore = math.min(99, math.max(0, 35 + clamp01(math.abs(dirScore) / 100) * 35 + activity))
rawScoreR = math.round(rawScore)              // 源码 .round()
probability = f_calibrate(rawScoreR)          // 校准方向概率 %
reached = amplitude >= targetAmplitudePct     // 已达到妖币阈值 → 只观察不追

// ─────────────────────────────── 闸门（yao.rs::analyze 的 blocker 链） ───────────────────────────────
isLong  = dirRaw > 0
signF   = dirRaw            // ±1

okNotReached = not reached
okProb       = probability >= minProbabilityPct
okRaw        = rawScoreR >= minRawProbability
okAmp        = amplitude >= minCurrentAmp and amplitude <= maxCurrentAmp
okVol        = vr >= minVolumeRatio
okRng        = rr >= minRangeRatio
okCons       = math.abs(consistency) >= minConsistencyPct
ok6h         = range6h >= minRange6hPct
okDist       = distHigh >= minDistHigh24hPct
signRet      = signF * recentRet
okRetLo      = signRet >= minRetDirPct
okRetHi      = signRet <= maxRetDirPct
// 对应源码: blocker if (long && shortOnly) || (!long && longOnly)
okDirSwitch  = not ((isLong and shortOnly) or (not isLong and longOnly))

// 15m 趋势确认
sepAtr15  = atr15 > 0 ? (emaF15 - emaS15) / atr15 : na
aligned15 = signF * (emaF15 - emaS15) > 0
separated = not na(sepAtr15) and math.abs(sepAtr15) >= minSepAtr
okTrend15 = not require15mTrend or (aligned15 and separated)

// ─────────────────────────────── 价位计划（features 的 levels + analyze 覆盖） ───────────────────────────────
// 预测层价位
pull       = math.min(math.max(atr1m * entryPullbackAtr, close * 0.002), close * 0.03)
low20      = ta.lowest(low, 20)
high20     = ta.highest(high, 20)
support    = math.max(math.min(low20 + atr1m * 0.35, close), close * 0.97)
resistance = math.min(math.max(high20 - atr1m * 0.35, close), close * 1.03)
entryPx    = isLong ? math.min(math.max(close - pull, support), close)
     : math.max(math.min(close + pull, resistance), close)
half       = math.max(atr1m * entryBandAtr, entryPx * 0.002)
eMin0      = isLong ? math.max(entryPx - half, close * 0.9) : math.max(entryPx - half, close)
eMax0      = isLong ? math.min(entryPx + half, close) : math.min(entryPx + half, close * 1.1)
e0 = math.min(eMin0, eMax0)
e1 = math.max(eMin0, eMax0)

// 执行层止损（analyze 里用 stopAtr / minStopPct 重算）
riskPx = math.max(atr1m * stopAtrMult, entryPx * minStopPct)
stopPx = isLong ? math.min(entryPx - riskPx, e0 - atr1m * 0.1)
     : math.max(entryPx + riskPx, e1 + atr1m * 0.1)

maxR   = math.max(tp1R, math.max(tp2R, tp3R))
target = entryPx + signF * riskPx * maxR
worst  = isLong ? e1 : e0

// 成本后盈亏比（与 analyze 相同公式）
costPx = worst * (2 * (feeBps + slipBps) + fundingBps * maxHoldBars / 60 / 8) / 10000
netRr  = (math.abs(target - worst) - costPx) / (math.abs(worst - stopPx) + costPx)
okNetRr = netRr >= minNetRr

// 限价单价格有效性
levelsValid = e0 > 0 and e1 > 0 and entryPx > 0 and not na(atr1m) and atr1m > 0 and e0 <= e1

// ─────────────────────────────── 信号汇总 ───────────────────────────────
signalValid = sufficient and not na(chg24) and dirRaw != 0 and levelsValid and
     okNotReached and okProb and okRaw and okAmp and okVol and okRng and okCons and
     ok6h and okDist and okRetLo and okRetHi and okDirSwitch and okTrend15 and okNetRr

signalLong  = signalValid and isLong
signalShort = signalValid and not isLong

// ─────────────────────────────── 订单管理 ───────────────────────────────
var float planEntry  = na
var float planStop0  = na
var float planRisk   = na
var float planTp1    = na
var float planTp2    = na
var float planTp3    = na
var int   planDir    = 0
var int   planBar    = na
var bool  orderPending = false
var bool  prevInPos  = false
var int   posBar     = na
var float trailStop  = na
var float peak       = na

// 复位（Pine 函数不能改全局变量，这里用标志位统一内联处理）
var bool doReset = false

flat = strategy.position_size == 0

// 挂单：埋伏限价
if flat and not orderPending and (signalLong or signalShort)
    planDir   := isLong ? 1 : -1
    planEntry := entryPx
    planStop0 := stopPx
    planRisk  := riskPx
    planTp1   := entryPx + signF * riskPx * math.min(tp1R, math.min(tp2R, tp3R))
    planTp2   := entryPx + signF * riskPx * math.max(math.min(tp1R, tp2R), math.min(math.max(tp1R, tp2R), tp3R))
    planTp3   := entryPx + signF * riskPx * maxR
    planBar   := bar_index
    orderPending := true
    strategy.entry("YAO", isLong ? strategy.long : strategy.short, limit = entryPx)

// 挂单成交
if orderPending and not flat
    orderPending := false

// 限价单超时撤单
doReset := false
if orderPending and flat and bar_index - planBar > orderExpiryBars
    strategy.cancel("YAO")
    doReset := true

inPos = not flat

// 建仓初始化
if inPos and not prevInPos
    posBar    := bar_index
    trailStop := planStop0
    peak      := close

// 持仓中：阶梯移动止损 + 分档止盈 + 超时
if inPos and planDir != 0
    ep = strategy.opentrades_entry_price(0)
    // 当根最好触点估算已实现 R
    bestPx = planDir > 0 ? high : low
    profitR = planDir > 0 ? (bestPx - ep) / planRisk : (ep - bestPx) / planRisk
    peak := planDir > 0 ? math.max(nz(peak, bestPx), bestPx) : math.min(nz(peak, bestPx), bestPx)

    // yao_exit ladder: (atR, trailR, lockR) = (0,0.7,0), (1,0.5,0.3), (2,0.4,0.8)
    float t = planStop0
    if profitR >= 0
        t := planDir > 0 ? math.max(t, peak - 0.7 * planRisk) : math.min(t, peak + 0.7 * planRisk)
    if profitR >= 1
        t := planDir > 0 ? math.max(t, peak - 0.5 * planRisk, ep + 0.3 * planRisk)
             : math.min(t, peak + 0.5 * planRisk, ep - 0.3 * planRisk)
    if profitR >= 2
        t := planDir > 0 ? math.max(t, peak - 0.4 * planRisk, ep + 0.8 * planRisk)
             : math.min(t, peak + 0.4 * planRisk, ep - 0.8 * planRisk)
    trailStop := t

    // 分档止盈：TP1/TP2 各 40%，剩余 TP3
    strategy.exit("TP1", "YAO", qty_percent = 40, limit = planTp1, stop = trailStop)
    strategy.exit("TP2", "YAO", qty_percent = 40, limit = planTp2, stop = trailStop)
    strategy.exit("TP3", "YAO", limit = planTp3, stop = trailStop)

    // 超时强平（对应 maxHoldBars 结算）
    if bar_index - posBar >= maxHoldBars
        strategy.close("YAO", comment = "timeout")

// 平仓后复位
if (not inPos and prevInPos) or doReset
    planEntry    := na
    planStop0    := na
    planRisk     := na
    planTp1      := na
    planTp2      := na
    planTp3      := na
    planDir      := 0
    planBar      := na
    orderPending := false
    trailStop    := na
    peak         := na
    posBar       := na
prevInPos := inPos

// ─────────────────────────────── 可视化 ───────────────────────────────
plotshape(signalLong, "妖币埋伏·多", shape.triangleup, location.belowbar,
     color = color.new(color.red, 0), size = size.small)
plotshape(signalShort, "妖币埋伏·空", shape.triangledown, location.abovebar,
     color = color.new(color.green, 0), size = size.small)

plot(showPlan and (inPos or orderPending) ? planEntry : na, "埋伏入场价", color.new(color.orange, 0), 1, plot.style_linebr)
plot(showPlan and inPos ? trailStop : na, "移动止损", color.new(color.red, 0), 1, plot.style_linebr)
plot(showPlan and inPos ? planTp1 : na, "TP1", color.new(color.teal, 40), 1, plot.style_linebr)
plot(showPlan and inPos ? planTp2 : na, "TP2", color.new(color.teal, 20), 1, plot.style_linebr)
plot(showPlan and inPos ? planTp3 : na, "TP3", color.new(color.teal, 0), 1, plot.style_linebr)

// 关键中间量（数据窗口）
plot(reached ? 1 : 0, "已达妖币阈值", display = display.data_window)
plot(rawScoreR, "原始规则分数", display = display.data_window)
plot(probability, "校准方向概率 %", display = display.data_window)
plot(amplitude, "观察振幅 %", display = display.data_window)
plot(vr, "量能比", display = display.data_window)
plot(rr, "波动比", display = display.data_window)
plot(netRr, "成本后盈亏比", display = display.data_window)

// ─────────────────────────────── 告警 ───────────────────────────────
alertcondition(signalLong, "YAO 埋伏·做多信号", "妖币埋伏: 出现做多埋伏信号，限价单已按计划挂出")
alertcondition(signalShort, "YAO 埋伏·做空信号", "妖币埋伏: 出现做空埋伏信号，限价单已按计划挂出")
alertcondition(reached, "YAO 已达阈值", "该币 24h 涨跌/振幅已达到目标阈值，埋伏失效，勿追")
